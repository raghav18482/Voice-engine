# Optional. With no key the agent runs on deterministic rules only (fully demoable).
# Set ONE of these to let an LLM help understand free-form answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_TIMEOUT=4

# Swap in CIMET's journey sandbox on the day (leave blank to use the built-in mock).
SANDBOX_URL=
SANDBOX_TOKEN=

# Guardrail toggles
ENFORCE_CALLING_HOURS=false
HANDOFF_TIMEOUT_SECONDS=90

# Twilio phone calls (optional). Leave blank to use the browser voice only.
# PUBLIC_BASE_URL is the https address Twilio can reach: your ngrok URL locally, or the Render URL.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_BASE_URL=
TWILIO_LANGUAGE=en-AU
# Optional voice, e.g. TWILIO_TTS_PROVIDER=ElevenLabs / Google / Amazon with a matching TWILIO_TTS_VOICE
TWILIO_TTS_PROVIDER=
TWILIO_TTS_VOICE=
# Seconds of caller silence before the agent re-asks, then ends with a callback
TWILIO_SILENCE_SECONDS=12
# Local debugging only: skip X-Twilio-Signature checks on webhooks
TWILIO_SKIP_SIGNATURE=false
