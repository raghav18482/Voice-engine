# Optional. With no key the agent runs on deterministic rules only (fully demoable).
# Set ONE of these to let an LLM help understand free-form answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_TIMEOUT=4

# Swap in CIMET's journey sandbox on the day (leave blank to use the built-in mock).
SANDBOX_URL=
SANDBOX_TOKEN=

# Guardrail toggles
ENFORCE_CALLING_HOURS=false
HANDOFF_TIMEOUT_SECONDS=90
